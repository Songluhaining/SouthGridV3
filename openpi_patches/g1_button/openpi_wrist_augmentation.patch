@@ -36,6 +36,16 @@ class Pi0Config(_model.BaseModelConfig):
     dino_predictor_hidden_dim: int = 512
     dino_world_loss_weight: float = 0.1
 
+    # 腕相机几何增强强度（上游默认完全不增强腕相机）。
+    # wrist_aug_crop<1 时随机裁剪到该比例再缩放回原尺寸（等效随机平移 + 轻微缩放）；
+    # wrist_aug_rotate_deg>0 时额外随机旋转 ±该角度。
+    wrist_aug_crop: float = 1.0
+    wrist_aug_rotate_deg: float = 0.0
+    # 腕相机高斯噪声增强：每样本从 [0, 该值] 均匀取 sigma（图像已归一到 [0,1]）。
+    # 依据：评测帧在停滞点加噪 sigma=20/255 可恢复约 2/3 的前进驱动力，
+    # 说明模型抓住了细微外观结构并据此刹车；噪声增强让它不再依赖这些结构。
+    wrist_aug_noise: float = 0.0
+
     # This config option is not used directly by the model, but it is read by the ModelTransformFactory.
     discrete_state_input: bool = None  # type: ignore
 
